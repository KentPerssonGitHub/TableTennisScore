<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.TableTennisScore.TextView" parent="@style/Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/goldman</item>
        <item name="fontFamily">@font/goldman</item>
