<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/ivTableBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:src="@drawable/bg_table_tennis_table"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBatLeft"
        android:layout_width="72dp"
        android:layout_height="112dp"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_table_tennis_bat_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintHorizontal_bias="0.72"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.64" />

    <ImageView
        android:id="@+id/ivBatRight"
        android:layout_width="72dp"
        android:layout_height="112dp"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleX="-1"
        android:src="@drawable/ic_table_tennis_bat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.64" />

    <!-- ===== LEFT PLAYER (Player 1) ===== -->
    <!-- Player 1 name (long-press to edit) -->
    <TextView
        android:id="@+id/tvPlayer1Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/cd_edit_player1"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center"
        android:longClickable="true"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/player1_default"
        android:textColor="@color/player_name"
        android:textSize="18sp"
        android:textStyle="normal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Player 1 score -->
    <TextView
        android:id="@+id/tvScore1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="top|end"
        android:includeFontPadding="false"
        android:longClickable="true"
        android:paddingTop="24dp"
        android:paddingEnd="42dp"
        android:text="0"
        android:textColor="@color/scoreboard_point_text"
        android:textSize="74sp"
        android:textStyle="normal"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/setBoardsRow" />

    <!-- Player 1 serve indicator -->
    <ImageView
        android:id="@+id/ivServe1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/cd_serve_indicator"
        android:elevation="10dp"
        android:src="@drawable/stigaperform40size128"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/tvPlayer1Name"
        app:layout_constraintStart_toStartOf="@id/tvPlayer1Name"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer1Name" />

    <!-- ===== CENTER ALIGNMENT GUIDELINE ===== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Player 2 name (long-press to edit) -->
    <TextView
        android:id="@+id/tvPlayer2Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/cd_edit_player2"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center"
        android:longClickable="true"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/player2_default"
        android:textColor="@color/player_name"
        android:textSize="18sp"
        android:textStyle="normal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/playerNamesBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvPlayer1Name,tvPlayer2Name" />

    <LinearLayout
        android:id="@+id/setBoardsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSet1"
            android:layout_width="44dp"
            android:layout_height="66dp"
            android:layout_marginEnd="1dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingBottom="4dp"
            android:text="0"
            android:textColor="@color/scoreboard_set_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSet2"
            android:layout_width="44dp"
            android:layout_height="66dp"
            android:layout_marginStart="1dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingBottom="4dp"
            android:text="0"
            android:textColor="@color/scoreboard_set_text"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Player 2 score -->
    <TextView
        android:id="@+id/tvScore2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="top|start"
        android:includeFontPadding="false"
        android:longClickable="true"
        android:paddingTop="24dp"
        android:paddingStart="42dp"
        android:text="0"
        android:textColor="@color/scoreboard_point_text"
        android:textSize="74sp"
        android:textStyle="normal"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toTopOf="@id/setBoardsRow" />

    <!-- Player 2 serve indicator -->
    <ImageView
        android:id="@+id/ivServe2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/cd_serve_indicator"
        android:elevation="10dp"
        android:src="@drawable/stigaperform40size128"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/tvPlayer2Name"
        app:layout_constraintStart_toStartOf="@id/tvPlayer2Name"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer2Name" />

    <!-- ===== CENTER CONTROLS ===== -->
    <LinearLayout
        android:id="@+id/centerControlsRow"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnStartMatch"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:elevation="1dp"
            android:contentDescription="@string/btn_start_match"
            android:text="@string/btn_start_match" />

        <TextView
            android:id="@+id/btnPauseMatchText"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:elevation="1dp"
            android:text="@string/btn_pause_match"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSetupMatch"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:elevation="1dp"
            android:contentDescription="@string/btn_setup_match"
            android:text="@string/btn_setup_match" />

        <TextView
            android:id="@+id/btnUndoText"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:elevation="1dp"
            android:text="@string/btn_undo"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:elevation="1dp"
            android:text="@string/btn_history" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUndo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPauseMatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMatchTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:includeFontPadding="false"
        android:text="@string/match_timer_default"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 37.5% = 75% of left half; right counterpart at 62.5% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP1SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP2SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <LinearLayout
        android:id="@+id/matchSummaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC220000"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMatchSummaryWinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TableLayout
            android:id="@+id/tableMatchSummaryScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvMatchSummaryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:textColor="@color/score_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tournament name at the bottom center; long press to edit -->
    <TextView
        android:id="@+id/tvTournamentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:alpha="0.55"
        android:background="?attr/selectableItemBackground"
        android:clickable="false"
        android:contentDescription="@string/cd_tournament_name"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:longClickable="true"
        android:padding="8dp"
        android:text="@string/tournament_name_default"
        android:textColor="@color/player_name"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ivSwapSides"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="-16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_swap_sides"
        android:elevation="12dp"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_swap_horiz"
        android:tint="@color/player_name"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toBottomOf="@id/setBoardsRow" />

    <com.example.tabletennisscore.animation.RallyBallGLView
        android:id="@+id/glRallyBall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Full-height tap targets: tapping anywhere on a half adds a point to that player.
         Kept at a low elevation so the score/name/serve views on top keep their own gestures. -->
    <View
        android:id="@+id/tapAreaLeft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/tapAreaRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/serveDragTouchOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:elevation="32dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
