<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <!-- ===== LEFT PLAYER (Player 1) ===== -->

    <!-- Player 1 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer1Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player1_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="16dp" />

    <!-- Player 1 score -->
    <TextView
        android:id="@+id/tvScore1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer1Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginBottom="16dp" />

    <!-- Player 1 serve indicator -->
    <ImageView
        android:id="@+id/ivServe1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="@id/tvScore1"
        app:layout_constraintEnd_toEndOf="@id/tvScore1"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER ALIGNMENT GUIDELINE ===== -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Player 2 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer2Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player2_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp" />

    <!-- Player 2 score -->
    <TextView
        android:id="@+id/tvScore2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer2Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Player 2 serve indicator -->
    <ImageView
        android:id="@+id/ivServe2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore2"
        app:layout_constraintStart_toStartOf="@id/tvScore2"
        app:layout_constraintEnd_toEndOf="@id/tvScore2"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER CONTROLS ===== -->

    <!-- Keep controls in a vertical column with borders and dividers. -->
    <LinearLayout
        android:id="@+id/centerControlsRow"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/menu_column_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dividerStartTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/btnStartMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_match"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/dividerPauseTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/btnPauseMatchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_pause_match"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/dividerSetupTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/btnSetupMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_setup_match"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/dividerUndoTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/btnUndoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_undo"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/dividerHistoryTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />


        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_history"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/dividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUndo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPauseMatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvMatchTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:includeFontPadding="false"
        android:text="@string/match_timer_default"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 37.5% = 75% of left half; right counterpart at 62.5% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP1SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP2SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <LinearLayout
        android:id="@+id/matchSummaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC220000"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMatchSummaryWinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TableLayout
            android:id="@+id/tableMatchSummaryScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvMatchSummaryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.85"
            android:textColor="@color/score_text"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Tournament name at the bottom center; long press to edit -->
    <TextView
        android:id="@+id/tvTournamentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tournament_name_default"
        android:textColor="@color/player_name"
        android:textSize="16sp"
        android:alpha="0.55"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="false"
        android:longClickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_tournament_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ===== TOP LAYER (Z-ORDER) ===== -->

    <!-- Sets display in score area (center) -->
    <TextView
        android:id="@+id/tvSets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="0 - 0"
        android:textColor="#F9F090"
        android:textSize="68sp"
        android:textStyle="normal"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ivSwapSides"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_swap_sides"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_swap_horiz"
        android:tint="@color/player_name"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintEnd_toEndOf="@id/divider" />

    <ImageView
        android:id="@+id/ivRallyBall"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/stigaperform40size128"
        android:scaleType="fitCenter"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
