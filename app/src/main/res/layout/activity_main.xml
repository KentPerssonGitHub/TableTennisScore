<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <!-- ===== LEFT PLAYER (Player 1) ===== -->

    <!-- Player 1 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer1Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player1_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="16dp" />

    <!-- Player 1 score -->
    <TextView
        android:id="@+id/tvScore1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        android:gravity="center"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer1Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginBottom="16dp" />

    <!-- Player 1 serve indicator -->
    <ImageView
        android:id="@+id/ivServe1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="@id/tvScore1"
        app:layout_constraintEnd_toEndOf="@id/tvScore1"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER DIVIDER ===== -->

    <View
        android:id="@+id/divider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivRallyBall"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/stigaperform40size128"
        android:scaleType="fitCenter"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sets display in score area (center) -->
    <TextView
        android:id="@+id/tvSets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 - 0"
        android:textColor="@color/sets_text"
        android:textSize="68sp"
        android:textStyle="normal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintEnd_toEndOf="@id/divider"
        android:layout_marginTop="16dp" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ivSwapSides"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_swap_sides"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_swap_horiz"
        android:tint="@color/player_name"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintEnd_toEndOf="@id/divider" />

    <!-- ===== RIGHT PLAYER (Player 2) ===== -->

    <!-- Player 2 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer2Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player2_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp" />

    <!-- Player 2 score -->
    <TextView
        android:id="@+id/tvScore2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        android:gravity="center"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer2Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Player 2 serve indicator -->
    <ImageView
        android:id="@+id/ivServe2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore2"
        app:layout_constraintStart_toStartOf="@id/tvScore2"
        app:layout_constraintEnd_toEndOf="@id/tvScore2"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER CONTROLS ===== -->

    <!-- Keep controls in a vertical row so buttons align top-to-bottom. -->
    <LinearLayout
        android:id="@+id/centerControlsRow"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tvScore1"
        app:layout_constraintBottom_toBottomOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartMatch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_start_match"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupMatch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_setup_match"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditScore"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_edit_score"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUndo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_undo"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnPauseMatch" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPauseMatch"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_pause_match"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextClock
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvMatchTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:includeFontPadding="false"
        android:text="@string/match_timer_default"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 37.5% = 75% of left half; right counterpart at 62.5% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP1SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP2SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <LinearLayout
        android:id="@+id/matchSummaryPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineP1SummaryEnd"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMatchSummaryWinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/score_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TableLayout
            android:id="@+id/tableMatchSummaryScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvMatchSummaryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.85"
            android:textColor="@color/score_text"
            android:textSize="10sp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
