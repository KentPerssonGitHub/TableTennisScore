<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <!-- ===== LEFT PLAYER (Player 1) ===== -->

    <!-- Player 1 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer1Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player1_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginTop="16dp" />

    <!-- Player 1 score -->
    <TextView
        android:id="@+id/tvScore1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer1Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        android:layout_marginBottom="16dp" />

    <!-- Player 1 serve indicator -->
    <ImageView
        android:id="@+id/ivServe1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="@id/tvScore1"
        app:layout_constraintEnd_toEndOf="@id/tvScore1"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER DIVIDER ===== -->

    <View
        android:id="@+id/divider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sets display in center top -->
    <TextView
        android:id="@+id/tvSets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 - 0"
        android:textColor="@color/sets_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintEnd_toEndOf="@id/divider"
        android:layout_marginTop="16dp" />

    <!-- ===== RIGHT PLAYER (Player 2) ===== -->

    <!-- Player 2 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer2Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/player2_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_edit_player2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Player 2 score -->
    <TextView
        android:id="@+id/tvScore2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer2Name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Player 2 serve indicator -->
    <ImageView
        android:id="@+id/ivServe2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/stigaperform40size128"
        android:contentDescription="@string/cd_serve_indicator"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/tvScore2"
        app:layout_constraintStart_toStartOf="@id/tvScore2"
        app:layout_constraintEnd_toEndOf="@id/tvScore2"
        android:layout_marginTop="12dp" />

    <!-- ===== CENTER CONTROLS ===== -->

    <!-- Keep controls in a vertical row so buttons align top-to-bottom. -->
    <LinearLayout
        android:id="@+id/centerControlsRow"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tvScore1"
        app:layout_constraintBottom_toBottomOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartMatch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_start_match"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupMatch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_setup_match"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset"
            android:textSize="14sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUndo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_undo"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnPauseMatch" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPauseMatch"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_pause_match"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
