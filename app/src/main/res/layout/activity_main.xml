<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/ivTableBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:src="@drawable/bg_table_tennis_table"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== LEFT PLAYER (Player 1) ===== -->
    <!-- Player 1 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer1Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/cd_edit_player1"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:padding="8dp"
        android:text="@string/player1_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Player 1 score -->
    <TextView
        android:id="@+id/tvScore1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:longClickable="true"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer1Name" />

    <!-- Player 1 serve indicator -->
    <ImageView
        android:id="@+id/ivServe1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/cd_serve_indicator"
        android:src="@drawable/stigaperform40size128"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/tvScore1"
        app:layout_constraintStart_toStartOf="@id/tvScore1"
        app:layout_constraintTop_toTopOf="@id/tvScore1" />

    <!-- ===== CENTER ALIGNMENT GUIDELINE ===== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Player 2 name (tap to edit) -->
    <TextView
        android:id="@+id/tvPlayer2Name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/cd_edit_player2"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:padding="8dp"
        android:text="@string/player2_default"
        android:textColor="@color/player_name"
        android:textSize="22sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Player 2 score -->
    <TextView
        android:id="@+id/tvScore2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:longClickable="true"
        android:text="0"
        android:textColor="@color/score_text"
        android:textSize="120sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toBottomOf="@id/tvPlayer2Name" />

    <!-- Player 2 serve indicator -->
    <ImageView
        android:id="@+id/ivServe2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/cd_serve_indicator"
        android:src="@drawable/stigaperform40size128"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/tvScore2"
        app:layout_constraintStart_toStartOf="@id/tvScore2"
        app:layout_constraintTop_toTopOf="@id/tvScore2" />

    <!-- ===== CENTER CONTROLS ===== -->
    <LinearLayout
        android:id="@+id/centerControlsRow"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnStartMatch"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:contentDescription="@string/btn_start_match"
            android:text="@string/btn_start_match" />

        <TextView
            android:id="@+id/btnPauseMatchText"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:text="@string/btn_pause_match"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSetupMatch"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:contentDescription="@string/btn_setup_match"
            android:text="@string/btn_setup_match" />

        <TextView
            android:id="@+id/btnUndoText"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:text="@string/btn_undo"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/Widget.TableTennisScore.CenterMenuPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_center_menu_secondary_button"
            android:text="@string/btn_history" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUndo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPauseMatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMatchTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.25"
        android:includeFontPadding="false"
        android:text="@string/match_timer_default"
        android:textColor="@color/score_text"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 37.5% = 75% of left half; right counterpart at 62.5% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP1SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineP2SummaryEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <LinearLayout
        android:id="@+id/matchSummaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC220000"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMatchSummaryWinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TableLayout
            android:id="@+id/tableMatchSummaryScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvMatchSummaryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:textColor="@color/score_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tournament name at the bottom center; long press to edit -->
    <TextView
        android:id="@+id/tvTournamentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:alpha="0.55"
        android:background="?attr/selectableItemBackground"
        android:clickable="false"
        android:contentDescription="@string/cd_tournament_name"
        android:focusable="true"
        android:gravity="center"
        android:longClickable="true"
        android:padding="8dp"
        android:text="@string/tournament_name_default"
        android:textColor="@color/player_name"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== TOP LAYER (Z-ORDER) ===== -->
    <!-- Sets display in score area (center) -->
    <TextView
        android:id="@+id/tvSets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="0 - 0"
        android:textColor="#F9F090"
        android:textSize="68sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ivSwapSides"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_swap_sides"
        android:elevation="4dp"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_swap_horiz"
        android:tint="@color/player_name"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/divider"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.tabletennisscore.RallyBallGLView
        android:id="@+id/glRallyBall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
